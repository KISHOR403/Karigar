{
  "name": "karigar-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Karigar - Editorial Marketplace & Creator Platform for Indian Artisans and Handmade Craft",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @karigar/web dev",
    "dev:api": "pnpm --filter @karigar/api start:dev",
    "dev:worker": "pnpm --filter @karigar/worker start:dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @karigar/database db:generate",
    "db:migrate": "pnpm --filter @karigar/database db:migrate",
    "db:seed": "pnpm --filter @karigar/database db:seed"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
